{
  "name": "zapret-manager",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:check": "tsc && vite build && node scripts/perf-check.js && node scripts/check-build-protection.mjs",
    "perf:check": "node scripts/perf-check.js",
    "lint:protection": "node scripts/check-build-protection.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:soak": "node scripts/soak-check.mjs",
    "lint:dead": "knip",
    "lint:i18n": "node scripts/i18n-check.mjs",
    "lint:release": "node scripts/check-release-metadata.mjs",
    "lint:css": "node scripts/check-ui-css.mjs",
    "release:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:dead && pnpm lint:i18n && pnpm lint:css && pnpm lint:release && pnpm test && cargo test --manifest-path src-tauri/Cargo.toml && pnpm cargo:check",
    "lint:bundle": "node scripts/check-bundle-links.mjs",
    "release:check:full": "pnpm release:check && pnpm e2e && pnpm build:check && pnpm lint:bundle && pnpm tauri build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "installer:bitmaps": "node scripts/build-bitmaps.js",
    "installer:hooks": "node scripts/build-installer-hooks.js",
    "installer:check": "node scripts/build-installer-hooks.js --check",
    "sign:windows": "node scripts/sign-windows.js",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "release:local": "node scripts/release-local.mjs",
    "bump": "node scripts/bump-version.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock --deny warnings",
    "audit:js": "pnpm audit --audit-level=high",
    "icons:build": "node scripts/build-icons.mjs",
    "resources:manifest": "node scripts/generate-manifest.js",
    "icons:tauri": "tauri icon src-tauri/icons/icon-source.png"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.11.2",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-fs": "2.6.0",
    "clsx": "2.1.1",
    "framer-motion": "14.0.0",
    "immer": "11.1.21",
    "lucide-react": "1.52.0",
    "nanoid": "6.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "circle-flags": "^2.8.3",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-icons": "^16.34.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "^5.0.3"
  }
}
