{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zapret Manager",
  "version": "0.1.0",
  "identifier": "com.zapretmanager.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zapret Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "tray-menu",
        "title": "Zapret Manager",
        "url": "index.html?view=tray",
        "width": 236,
        "height": 332,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "shadow": false,
        "focus": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "publisher": "Zapret Manager Project",
    "copyright": "Copyright (c) 2026 Zapret Manager Project",
    "shortDescription": "Управление стратегиями обхода блокировок",
    "longDescription": "Zapret Manager — десктопное приложение для сканирования, запуска и мониторинга стратегий обхода блокировок zapret: Discord, YouTube, Outlast Trials.",
    "licenseFile": "installer/license.txt",
    "resources": ["resources/**/*", "icons/tray/*.png"],
    "windows": {
      "wix": {
        "language": ["ru-RU"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/bitmaps/header.bmp",
        "sidebarImage": "installer/bitmaps/welcome.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/custom-template.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
